# Exemple de configuration de l'API Express.
# Ne jamais mettre de secret réel dans ce fichier : il est versionné.

# Port d'écoute de l'API
PORT=3001
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# Connexion PostgreSQL (en local : base lancée par Docker Compose sur le port 5433)
# Dans Docker Compose, cette variable est fournie par docker-compose.yml (hôte "db")
DATABASE_URL="postgresql://portfolio:changez-moi@localhost:5433/portfolio"