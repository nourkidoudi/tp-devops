# Exemple de configuration du frontend Next.js.
# Copier ce fichier en .env.local et adapter les valeurs.
# Ne jamais mettre de secret réel dans ce fichier : il est versionné.

# URL de l'API Express, sans slash final
# - en local : http://localhost:3001
# - avec Docker Compose : http://api:3001
API_URL=http://localhost:3001
